# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml for local dev,
# OR paste these key-value pairs into the Streamlit Community Cloud → Secrets UI.
#
# Get a free Gemini key: https://aistudio.google.com/app/apikey

GOOGLE_API_KEY        = "your_gemini_api_key_here"
DASHBOARD_USERNAME    = "admin"
DASHBOARD_PASSWORD    = "changeme123"
JWT_SECRET            = "replace_with_a_long_random_secret_string"
